{
	"name": "@e280/renraku",
	"version": "0.6.0-0",
	"description": "expose async functions as an api",
	"license": "MIT",
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"type": "module",
	"main": "./x/index.js",
	"exports": {
		".": "./x/core/index.js",
		"./node": "./x/node/index.js",
		"./web": "./x/web/index.js"
	},
	"files": [
		"x",
		"s"
	],
	"scripts": {
		"build": "rm -rf x && mkdir x && ln -s \"$(realpath s)\" x/s && tsc && scute -v",
		"check": "tsc && scute -vw",
		"dev": "octo 'node --watch x/test.js' 'tsc -w' 'scute -vw'",
		"test": "node x/test.js",
		"count": "find s -path '*/_archive' -prune -o -name '*.ts' -exec wc -l {} +"
	},
	"dependencies": {
		"@e280/stz": "^0.3.0"
	},
	"devDependencies": {
		"@e280/octo": "^0.1.1",
		"@e280/science": "^0.1.11",
		"@e280/scute": "^0.3.3",
		"@types/node": "^25.9.3",
		"http-server": "^14.1.1",
		"typescript": "^6.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	},
	"homepage": "https://github.com/e280/renraku#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/e280/renraku.git"
	},
	"bugs": {
		"url": "https://github.com/e280/renraku/issues"
	},
	"keywords": [
		"rpc",
		"remote procedure call",
		"json api",
		"json rpc",
		"api",
		"web api",
		"node api"
	]
}
